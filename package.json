{
  "name": "studynight",
  "private": true,
  "version": "1.0.0",
  "description": "Your notes, turned into a game. A mobile-first study app that turns your own material into verified quizzes.",
  "type": "module",
  "license": "UNLICENSED",
  "author": "Umit Kayaardi",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/copy-ort.mjs",
    "prebuild": "node scripts/copy-ort.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:strings": "node scripts/check-strings.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:licences": "node scripts/check-licences.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run check:i18n && npm run check:strings && npm run check:licences && npm run check:secrets",
    "live:check": "node scripts/live-check.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "benchmark": "node scripts/run-ts.mjs benchmarks/run.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
