    "@fontsource/noto-sans-kr": "5.3.1",
    "@fontsource/noto-sans-sc": "5.3.1",
    "@huggingface/transformers": "4.3.2",
    "canvas-confetti": "1.9.4",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "framer-motion": "14.11.1",
    "franc-min": "6.2.0",
    "groq-sdk": "1.6.0",
    "highlight.js": "11.12.0",
    "html-to-image": "1.11.13",
    "i18next": "27.0.1",
    "jszip": "3.10.2",
    "katex": "0.19.1",
    "lucide-react": "1.70.0",
    "lz-string": "1.5.0",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.1",
    "ts-fsrs": "6.0.0",
